FROM alpine:3.22
RUN apk add --no-cache curl
WORKDIR /app
COPY main migrate ./
COPY --chmod=755 entrypoint.sh .
COPY config ./config
EXPOSE 8083
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8083/account/health || exit 1
CMD ["./entrypoint.sh"]
